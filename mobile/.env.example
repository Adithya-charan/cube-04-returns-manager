# Frontend Environment Variables
# Copy this file to .env.local or .env and set your values.

# API Base URL for the FastAPI backend.
# For local development: http://localhost:8000
# For LAN development (phone on same Wi-Fi): http://<PC-LAN-IP>:8000
# Example: http://192.168.1.50:8000
VITE_API_BASE=http://localhost:8000