# CUBE Returns Manager — Environment Variables
# Copy this file to .env and set your values.
# No external AI API keys are required.

# ── Ollama Vision (required for production) ───────────────────────────────
# URL of your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Vision model to use. Must be a multimodal (vision) model.
OLLAMA_VISION_MODEL=qwen3-vl:8b

# Request timeout in seconds for vision inference.
OLLAMA_TIMEOUT_SECONDS=120

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default, for local dev):
DATABASE_URL=sqlite:///./returns_manager.db

# PostgreSQL Example (Neon) using psycopg2:
DATABASE_URL=postgresql+psycopg2://user:password@ep-cold-shadow-1234.us-east-2.aws.neon.tech/returns_manager

# ── YOLO Vision ────────────────────────────────────────────────────────
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45

# ── Object Storage (S3 / Cloudflare R2) ────────────────────────────────
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ── Security ───────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*
